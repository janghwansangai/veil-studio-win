{
  "name": "veil-studio",
  "productName": "Veil Studio",
  "version": "0.7.0",
  "description": "Windows용 얼굴·영역 마스킹 영상 편집기",
  "author": "다있쌤 로디",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "selftest": "electron . --selftest",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-builder --win nsis --x64",
    "patch-whisper": "node scripts/utf8-manifest.cjs resources/speech/bin/whisper-cli.exe",
    "fetch-resources": "node scripts/fetch-resources.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "htm": "^3.1.1",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "studio.veil.editor",
    "productName": "Veil Studio",
    "copyright": "다있쌤 로디",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/bin/**"
    ],
    "extraResources": [
      {
        "from": "resources/speech",
        "to": "speech"
      },
      {
        "from": "resources/face",
        "to": "face"
      },
      {
        "from": "resources/separation",
        "to": "separation"
      }
    ],
    "fileAssociations": [
      {
        "ext": "veilproject",
        "name": "Veil Studio 프로젝트",
        "description": "Veil Studio 프로젝트",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "VeilStudio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Veil Studio",
      "artifactName": "VeilStudio-Setup-${version}.exe",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042"
    },
    "extraFiles": [
      {
        "from": "resources/vcruntime",
        "to": "."
      }
    ]
  }
}
